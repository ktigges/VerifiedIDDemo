{
  "locale": "en-US",
  "card": {
    "title": "YOUR ORGANIZATION Employee Card",
    "issuedBy": "YOUR ORGANIZATION",
    "backgroundColor": "#0F6CBD",
    "textColor": "#FFFFFF",
    "description": "Use this card to prove employment during onboarding and access checks."
  },
  "consent": {
    "title": "Do you want your employee card?",
    "instructions": "Accept this credential into Microsoft Authenticator to continue."
  },
  "claims": [
    {
      "claim": "vc.credentialSubject.givenName",
      "label": "First name",
      "type": "String"
    },
    {
      "claim": "vc.credentialSubject.familyName",
      "label": "Last name",
      "type": "String"
    },
    {
      "claim": "vc.credentialSubject.email",
      "label": "Work email",
      "type": "String"
    },
    {
      "claim": "vc.credentialSubject.jobTitle",
      "label": "Job title",
      "type": "String"
    },
    {
      "claim": "vc.credentialSubject.department",
      "label": "Department",
      "type": "String"
    },
    {
      "claim": "vc.credentialSubject.employeeId",
      "label": "Credential reference",
      "type": "String"
    },
    {
      "claim": "vc.credentialSubject.photo",
      "label": "Employee photo",
      "type": "image/jpg;base64url"
    }
  ]
}
